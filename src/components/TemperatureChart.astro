<section class="temperature-chart" aria-labelledby="temperature-chart-heading">
  <div class="chart-heading">
    <div>
      <p class="eyebrow">Daily profile</p>
      <h3 id="temperature-chart-heading">Temperature chart</h3>
    </div>
  </div>

  <div class="chart-viewport">
    <svg
      class="chart"
      data-temperature-chart
      viewBox="0 0 760 360"
      role="img"
      aria-labelledby="temperature-chart-title temperature-chart-description"
    >
      <title id="temperature-chart-title">Hourly temperature chart</title>
      <desc id="temperature-chart-description">
        Line chart with hour of the day on the horizontal axis and temperature on the vertical axis.
      </desc>
    </svg>
  </div>
</section>
